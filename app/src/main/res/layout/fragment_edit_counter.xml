<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Editar Contador"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:layout_marginBottom="32dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Título"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:layout_marginBottom="8dp"/>

        <EditText
            android:id="@+id/etEditTitle"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:hint="Título del contador"
            android:textColorHint="@color/text_secondary"
            android:textColor="@color/white"
            android:background="@drawable/bg_edittext_dark"
            android:paddingHorizontal="16dp"
            android:inputType="text"
            android:layout_marginBottom="24dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Descripción"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:layout_marginBottom="8dp"/>

        <EditText
            android:id="@+id/etEditDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Descripción (opcional)"
            android:textColorHint="@color/text_secondary"
            android:textColor="@color/white"
            android:background="@drawable/bg_edittext_dark"
            android:padding="16dp"
            android:inputType="textMultiLine"
            android:minLines="3"
            android:gravity="top"
            android:layout_marginBottom="24dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Fecha y hora de cierre"
            android:textColor="@color/white"
            android:textStyle="bold"
            android:layout_marginBottom="12dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="24dp">

            <Button
                android:id="@+id/btnEditPickDate"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:text="Seleccionar"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:backgroundTint="@color/surface_dark"
                app:shapeAppearanceOverlay="@style/PillShape" />

            <TextView
                android:id="@+id/tvEditSelectedDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="No seleccionada"
                android:textColor="@color/text_secondary"
                android:layout_marginStart="16dp" />

        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Imagen del contador"
            android:textColor="@color/white"
            android:textStyle="bold"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/btnEditPickImage"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="Elegir foto de la galería"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:backgroundTint="@color/surface_dark"
            app:shapeAppearanceOverlay="@style/PillShape"
            android:layout_marginBottom="16dp" />

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/ivEditPreview"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:scaleType="centerCrop"
            android:background="@color/surface_dark"
            app:shapeAppearanceOverlay="@style/PillShape"
            app:cornerSize="16dp"
            android:layout_marginBottom="32dp" />

        <Button
            android:id="@+id/btnSaveChanges"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Guardar Cambios"
            android:textAllCaps="false"
            android:textColor="@color/black"
            android:textStyle="bold"
            android:backgroundTint="@color/mint_primary"
            app:shapeAppearanceOverlay="@style/PillShape"
            android:layout_marginTop="8dp" />

    </LinearLayout>

</ScrollView>